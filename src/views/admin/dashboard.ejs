<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <h1>Dashboard</h1>

  <div class="stat-row">
    <div class="stat-card">
      <div class="stat-label">Today</div>
      <div class="stat-value"><%= peso(todayTotal.total || 0) %></div>
      <div class="stat-sub"><%= todayTotal.count %> transaction<%= todayTotal.count === 1 ? '' : 's' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Last 7 Days</div>
      <div class="stat-value"><%= peso(weekTotal.total || 0) %></div>
      <div class="stat-sub"><%= weekTotal.count %> transaction<%= weekTotal.count === 1 ? '' : 's' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">This Month</div>
      <div class="stat-value"><%= peso(monthTotal.total || 0) %></div>
      <div class="stat-sub"><%= monthTotal.count %> transaction<%= monthTotal.count === 1 ? '' : 's' %></div>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <h2>Sales Trend (7 days)</h2>
      <div class="chart-wrap">
        <canvas id="salesTrendChart" role="img" aria-label="Line chart of sales over the last 7 days"></canvas>
      </div>
    </div>

    <div class="card">
      <h2>Top Products (30 days)</h2>
      <% if (topProducts.length === 0) { %>
        <p class="muted">No sales recorded yet.</p>
      <% } else { %>
        <div class="table-scroll">
          <table class="table">
            <thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead>
            <tbody>
              <% topProducts.forEach(p => { %>
                <tr>
                  <td><%= p.product_name %></td>
                  <td><%= p.units_sold %></td>
                  <td><%= peso(p.revenue) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <h2>Low Stock Alerts</h2>
      <% if (lowStock.length === 0) { %>
        <p class="muted">All products are sufficiently stocked.</p>
      <% } else { %>
        <div class="table-scroll">
          <table class="table">
            <thead><tr><th>Product</th><th>Stock</th><th>Reorder Level</th></tr></thead>
            <tbody>
              <% lowStock.forEach(p => { %>
                <tr class="<%= p.stock_quantity <= 0 ? 'row-danger' : 'row-warning' %>">
                  <td><%= p.name %></td>
                  <td><%= p.stock_quantity %> <%= p.unit %></td>
                  <td><%= p.reorder_level %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="card">
      <h2>Recent Transactions</h2>
      <% if (recentSales.length === 0) { %>
        <p class="muted">No transactions yet.</p>
      <% } else { %>
        <div class="table-scroll">
          <table class="table">
            <thead><tr><th>Receipt</th><th>Cashier</th><th>Total</th><th>When</th></tr></thead>
            <tbody>
              <% recentSales.forEach(s => { %>
                <tr>
                  <td><a href="/admin/sales/<%= s.id %>"><%= s.receipt_no %></a></td>
                  <td><%= s.cashier %></td>
                  <td><%= peso(s.total_amount) %></td>
                  <td><%= s.created_at %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script src="/js/vendor/chart.umd.min.js"></script>
<script>
  // Serialize safely as JSON ("<" escaped so data can never close the script tag)
  const trendData = <%- JSON.stringify(trendData).replace(/</g, '\\u003c') %>;

  const ctx = document.getElementById('salesTrendChart');
  if (ctx && typeof Chart !== 'undefined') {
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: trendData.map(d => String(d.day).slice(5)),
        datasets: [{
          label: 'Sales (₱)',
          data: trendData.map(d => Number(d.total) || 0),
          borderColor: '#2b6cb0',
          backgroundColor: 'rgba(43, 108, 176, 0.15)',
          tension: 0.3,
          fill: true,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (item) => '₱' + Number(item.parsed.y).toLocaleString('en-PH', { minimumFractionDigits: 2 }),
            },
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { callback: (value) => '₱' + Number(value).toLocaleString('en-PH') },
          },
        },
      },
    });
  }
</script>
<%- include('../partials/foot') %>